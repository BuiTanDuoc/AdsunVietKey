<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VietKey</RootNamespace>
    <AssemblyName>AdsunVietKey</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>0.3.0</Version>
    <Product>VietKey</Product>
    <ApplicationIcon>VietKey.ico</ApplicationIcon>
    <Description>Bộ gõ tiếng Việt Telex/VNI viết bằng C# WinForms</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- SunnyUI: https://github.com/yhuse/SunnyUI (GPL-3.0) -->
    <PackageReference Include="SunnyUI" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VietKey.Core\AdsunVietKey.Core.csproj" />
  </ItemGroup>

</Project>
